generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TimelineEntry {
  id           String        @id @default(cuid())
  legacyKey    String        @unique @map("legacy_key")
  dataset      String
  title        String
  universe     String
  reality      String
  note         String?
  season       String?
  episodes     String?
  period       String?
  yearStart    Float?        @map("year_start")
  yearEnd      Float?        @map("year_end")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  watchRecords WatchRecord[]
  @@index([dataset, reality])
  @@index([title])
  @@map("timeline_entries")
}

model User {
  id           String             @id @default(cuid())
  externalId   String             @unique @map("external_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  watchRecords WatchRecord[]
  queueItems   ReleaseQueueItem[]
  @@map("users")
}

model WatchRecord {
  userId    String        @map("user_id")
  entryId   String        @map("entry_id")
  watchedAt DateTime      @default(now()) @map("watched_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry     TimelineEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@id([userId, entryId])
  @@index([entryId])
  @@map("watch_records")
}

model ReleaseQueueItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String   @db.VarChar(120)
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("release_queue_items")
}
